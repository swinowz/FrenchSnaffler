<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ShareAuditor</RootNamespace>
    <AssemblyName>ShareAuditor</AssemblyName>
    <DefineConstants>$(DefineConstants);ULTRASNAFFLER</DefineConstants>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>..\release\</OutputPath>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Perf/memoire : Server GC + concurrent + DATAS (redimensionne dynamiquement le tas) -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- DATAS : Dynamic Adaptation To Application Sizes (reduit l'empreinte du Server GC) -->
    <RuntimeHostConfigurationOption Include="System.GC.DynamicAdaptationMode" Value="1" Trim="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineArgumentsParser" Version="3.0.23" />
    <PackageReference Include="CommandLineParser.Core" Version="1.0.1" />
    <PackageReference Include="NLog" Version="5.3.4" />
    <PackageReference Include="EPPlus" Version="7.5.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SnaffCore\SnaffCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed all .toml rules as resources for single-file deployment -->
    <EmbeddedResource Include="SnaffRules\DefaultRules\**\*.toml" />
  </ItemGroup>

  <!-- Native packages (SkiaSharp via EPPlus) ship a large .pdb; keep it out of release output. -->
  <Target Name="RemoveStrayNativePdb" AfterTargets="Publish">
    <ItemGroup>
      <_StrayPdb Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_StrayPdb)" />
  </Target>

</Project>
